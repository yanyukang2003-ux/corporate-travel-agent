          "assess",
          "change_task",
          "replan",
          "notice"
        ],
        "note": "三档判定：开改期任务、只通知、只记录；改期任务在同一趟差旅下重走规划到交接。"
      },
      {
        "id": "active",
        "label": "旅行者主动",
        "focus": [
          "traveler",
          "change_task",
          "cancel"
        ],
        "note": "会议改期和航变自述直接落事件；取消整趟差旅就停观察，退改由人去办。"
      }
    ]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/corporate-travel-agent/fault-evaluation-case.schema.json",
  "title": "Corporate Travel Agent Fault Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "base_case_id",
    "fault_type",
    "injection_point",
    "behavior",
    "autonomous_recovery_expected",
    "safe_degradation_allowed",
    "description"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^fault-[a-z0-9-]+-[0-9]{2}$"
    },
    "base_case_id": {
      "type": "string",
      "pattern": "^prefer-[a-z0-9-]+$"
    },
    "fault_type": {
      "enum": [
        "timeout",
        "retryable_error",
        "non_retryable_error",
        "permission_denied",
        "empty_result",
        "stale_snapshot",
        "partial_result",
        "process_restart"
      ]
    },
    "injection_point": {
      "enum": [
        "provider.search_transport.outbound",
        "provider.search_hotels",
        "provider.revalidate",
        "provider.create_deep_link"
      ]
    },
    "behavior": {
      "enum": [
        "raise_once",
        "return_empty",
        "return_stale",
        "return_partial",
        "interrupt_started_call"
      ]
    },
    "autonomous_recovery_expected": {"type": "boolean"},
    "safe_degradation_allowed": {"type": "boolean"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}

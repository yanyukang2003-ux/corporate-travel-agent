  "cards": [
    {
      "dot": "cyan",
      "title": "观察节奏与入口",
      "items": [
        "第一次检查排在最早一段起飞前 48 h，越近越密，最密 15 min 一次，落地后停",
        "worker 按到点时间领取并写租约；没接动态源时一趟都不领",
        "企业侧推送验 HMAC-SHA256，可只带票号，同一班机上每趟差旅都算数"
      ]
    },
    {
      "dot": "rose",
      "title": "预防措施：确定性、可复核",
      "items": [
        "评估只看事实，结论带理由；取消、赶不上到场时限减缓冲、接驳不足才开改期",
        "改期任务只平移被改那一段，被取消的票排除在候选外；改期中的差旅不再领取",
        "交接前重验报价，涨价或售罄要重新确认；审批主题一变旧审批失效"
      ]
    },
    {
      "dot": "slate",
      "title": "边界与留痕",
      "items": [
        "系统不改签、不退票、不付钱；退改由人去官方平台办",
        "会议改期日期必须逐字引用旅行者原话；聊天变更最多两轮，读不出来就问",
        "每次非重复观察都记审计事件；通知与改期事件经发件箱至少一次投递"
      ]
    }
  ]
}

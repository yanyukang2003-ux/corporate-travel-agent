{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.corporate-travel-agent/evals/eval-trace.schema.json",
  "title": "Corporate Travel Agent evaluation trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "attempt",
    "evaluation_mode",
    "started_at",
    "completed_at",
    "fingerprint",
    "tool_choice_exposure",
    "steps",
    "final"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "evaluation_mode": {
      "enum": [
        "deterministic_mock",
        "deterministic_live_provider",
        "model_mock",
        "real_llm_mock_provider",
        "model_replay",
        "model_live_provider",
        "production_observation"
      ]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_version",
        "code_revision",
        "dataset_id",
        "dataset_version",
        "dataset_sha256",
        "prompt_version",
        "requested_model",
        "actual_model",
        "runner_version",
        "price_table_version"
      ],
      "properties": {
        "project_version": {"type": "string"},
        "code_revision": {"type": ["string", "null"]},
        "dataset_id": {"type": "string"},
        "dataset_version": {"type": "string"},
        "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "prompt_version": {"type": ["string", "null"]},
        "requested_model": {"type": ["string", "null"]},
        "actual_model": {"type": ["string", "null"]},
        "runner_version": {"type": "string"},
        "price_table_version": {"type": ["string", "null"]}
      }
    },
    "tool_choice_exposure": {
      "enum": ["orchestrator_controlled", "allowlisted_model_choice", "open_model_choice", "not_applicable"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "kind",
          "status",
          "started_at",
          "duration_ms",
          "state_before",
          "state_after",
          "name",
          "input_hash",
          "output_hash",
          "evidence_refs",
          "error_type",
          "retry_of",
          "token_usage"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "kind": {
            "enum": ["user", "llm", "tool", "policy", "state_transition", "recovery", "audit"]
          },
          "status": {"enum": ["success", "failure", "partial", "skipped"]},
          "started_at": {"type": "string", "format": "date-time"},
          "duration_ms": {"type": "number", "minimum": 0},
          "state_before": {"type": ["string", "null"]},
          "state_after": {"type": ["string", "null"]},
          "name": {"type": ["string", "null"]},
          "tool_kind": {"type": ["string", "null"]},
          "tool_call_sequence": {"type": ["integer", "null"], "minimum": 1},
          "redacted_input": {"type": ["object", "null"]},
          "input_hash": {"type": ["string", "null"]},
          "output_hash": {"type": ["string", "null"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "error_type": {"type": ["string", "null"]},
          "error_message_code": {"type": ["string", "null"]},
          "error_layer": {"type": ["string", "null"]},
          "error_cause_type": {"type": ["string", "null"]},
          "error_cause_chain": {
            "type": "array",
            "items": {"type": "string"}
          },
          "response_received": {"type": ["boolean", "null"]},
          "http_status": {
            "type": ["integer", "null"],
            "minimum": 100,
            "maximum": 599
          },
          "provider_request_id": {"type": ["string", "null"]},
          "retryable": {"type": ["boolean", "null"]},
          "retry_of": {"type": ["integer", "null"], "minimum": 1},
          "reason_code": {"type": ["string", "null"]},
          "token_usage": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "input_tokens",
              "output_tokens",
              "cached_input_tokens",
              "cache_write_input_tokens",
              "reasoning_output_tokens",
              "total_tokens"
            ],
            "properties": {
              "input_tokens": {"type": ["integer", "null"], "minimum": 0},
              "output_tokens": {"type": ["integer", "null"], "minimum": 0},
              "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
              "cache_write_input_tokens": {"type": ["integer", "null"], "minimum": 0},
              "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
              "total_tokens": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "policy_outcome",
        "booking_allowed",
        "result_refs",
        "user_response_hash",
        "failure_reason"
      ],
      "properties": {
        "state": {"type": ["string", "null"]},
        "policy_outcome": {"type": ["string", "null"]},
        "booking_allowed": {"type": ["boolean", "null"]},
        "result_refs": {"type": "array", "items": {"type": "string"}},
        "user_response_hash": {"type": ["string", "null"]},
        "failure_reason": {"type": ["string", "null"]}
      }
    }
  }
}

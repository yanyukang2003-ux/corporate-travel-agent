OPENAI_API_KEY=replace-with-server-side-key
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TIMEOUT_SECONDS=60
# Transient 429/5xx only. Never used for 402 billing failures.
OPENAI_FALLBACK_MODEL=
# OpenAI-compatible base (DeepSeek official). Omit to use OpenAI default.
OPENAI_BASE_URL=https://api.deepseek.com
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://travel_agent:travel_agent_dev@127.0.0.1:5432/travel_agent
DATABASE_AUTO_CREATE=false
RAW_RESPONSE_STORE_DIR=data/runtime/raw-provider-responses
RAW_RESPONSE_RETENTION_DAYS=90
AUTH_ENABLED=false
AUTH_USERS_FILE=data/runtime/auth-users.json
AUTH_SIGNING_SECRET=
AUTH_TOKEN_TTL_MINUTES=60
POLICY_CONFIG_FILE=config/travel-policy.json

# External travel inventory. Use mock, duffel, or duffel_liteapi.
TRAVEL_PROVIDER=mock
# Read-only provider resilience: 3 immediate attempts are the system default.
PROVIDER_CIRCUIT_OPEN_SECONDS=60
MAX_DELAYED_PROVIDER_RETRIES=3
PROVIDER_DELAYED_RETRY_SECONDS=60,180,600
PROVIDER_RETRY_POLL_SECONDS=5
# API workers do not consume retries. Run a dedicated process with PROCESS_ROLE=worker.
PROCESS_ROLE=api
PROVIDER_RETRY_WORKER_ID=
PROVIDER_RETRY_LEASE_SECONDS=900
# Trip watch: flight status polling after booking confirmation. none = never poll.
FLIGHT_STATUS_SOURCE=none
TRIP_WATCH_POLL_SECONDS=60
TRIP_WATCH_LEASE_SECONDS=300
TRIP_WATCH_LOOKAHEAD_HOURS=48
TRIP_CHANGE_MIN_CONNECTION_MINUTES=60
FLIGHT_DELAY_NOTICE_MINUTES=15
# Shared secret for POST /flight-status/webhook (HMAC-SHA256). Empty = webhook disabled.
FLIGHT_STATUS_WEBHOOK_SECRET=
TRIP_WATCH_WORKER_ID=
MAX_CONCURRENT_LLM_CALLS=8
MAX_CONCURRENT_PROVIDER_CALLS=16
TOOL_ACQUIRE_TIMEOUT_SECONDS=5
INTERRUPTED_TASK_STALE_SECONDS=30
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_VERSION=v2
DUFFEL_LIVE_MODE=false
# Keep in lockstep with active policy currency (default travel-policy is USD).
DUFFEL_EXPECTED_CURRENCY=USD

# LiteAPI/Nuitee Connect hotel rates. Search and quote refresh only.
# LITEAPI_CURRENCY must equal the active policy currency or hotel+flight
# itineraries are rejected as INSUFFICIENT_EVIDENCE (no FX conversion).
LITEAPI_API_KEY=
LITEAPI_API_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_REQUIRE_SANDBOX=true
LITEAPI_CURRENCY=USD
LITEAPI_GUEST_NATIONALITY=US
LITEAPI_ADULTS=1
LITEAPI_RESULT_LIMIT=10
LITEAPI_MAX_RATES_PER_HOTEL=3
LITEAPI_SUPPLIER_TIMEOUT_SECONDS=8
LITEAPI_LOCATIONS_JSON=
LITEAPI_BOOKING_ENABLED=false
LIVE_BOOKING_ENABLED=false

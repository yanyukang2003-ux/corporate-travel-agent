{
  "schema_version": 1,
  "registry_id": "corporate-travel-tool-registry-v2",
  "tool_choice_exposure": "orchestrator_controlled",
  "tools": [
    {
      "name": "llm.extract_trip_intent",
      "required_parameters": [
        "message",
        "task_id",
        "traveler_id",
        "context"
      ],
      "parameter_types": {
        "message": "string",
        "task_id": "string",
        "traveler_id": "string",
        "context": "object"
      },
      "allowed_states": [
        "DRAFT",
        "NEEDS_CLARIFICATION"
      ],
      "provenance": "Schema-bound intent extraction over the user message; the model returns fields only, never a tool choice."
    },
    {
      "name": "provider.search_transport.outbound",
      "required_parameters": [
        "origin",
        "destination",
        "depart_after",
        "arrive_before"
      ],
      "parameter_types": {
        "origin": "string",
        "destination": "string",
        "depart_after": "datetime",
        "arrive_before": "datetime"
      },
      "allowed_states": [
        "SEARCHING"
      ],
      "provenance": "Exact outbound route and window from the frozen case request."
    },
    {
      "name": "provider.search_transport.inbound",
      "required_parameters": [
        "origin",
        "destination",
        "depart_after",
        "arrive_before"
      ],
      "parameter_types": {
        "origin": "string",
        "destination": "string",
        "depart_after": "datetime",
        "arrive_before": "datetime"
      },
      "allowed_states": [
        "SEARCHING"
      ],
      "provenance": "Exact reverse route and return window from the frozen case request."
    },
    {
      "name": "provider.search_hotels",
      "required_parameters": [
        "city",
        "check_in",
        "check_out"
      ],
      "parameter_types": {
        "city": "string",
        "check_in": "date",
        "check_out": "date"
      },
      "allowed_states": [
        "SEARCHING"
      ],
      "provenance": "Exact destination and hotel dates from the frozen case request."
    },
    {
      "name": "provider.revalidate",
      "required_parameters": [
        "refs"
      ],
      "parameter_types": {
        "refs": "string_array"
      },
      "allowed_states": [
        "REVALIDATING"
      ],
      "provenance": "Exact selected inventory references, each previously returned by a successful search."
    },
    {
      "name": "provider.create_deep_link",
      "required_parameters": [
        "option_id",
        "option_version",
        "inventory_refs"
      ],
      "parameter_types": {
        "option_id": "string",
        "option_version": "positive_integer",
        "inventory_refs": "string_array"
      },
      "allowed_states": [
        "REVALIDATING"
      ],
      "provenance": "Exact selected option and inventory references after successful revalidation."
    }
  ]
}
